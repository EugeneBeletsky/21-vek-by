{
  "enabledMcpjsonServers": ["playwright"],
  "permissions": {
    "allow": [
      "Bash(npm run lint*)",
      "Bash(npm run typecheck)",
      "Bash(npm run verify)",
      "Bash(npm run format)",
      "Bash(npm run test:api)",
      "Bash(npm run test:ui)",
      "Bash(npm run test:smoke)",
      "Bash(npm run test:regression)",
      "Bash(npx playwright test*)",
      "Bash(npx playwright show-report)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx playwright install*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git status)"
    ],
    "deny": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsc --noEmit 2>&1 | head -20"
          }
        ]
      }
    ]
  }
}
